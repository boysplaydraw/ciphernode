# CipherNode Go relay environment

PORT=5000
HOST=0.0.0.0

# Relay limits
RATE_LIMIT_PER_MINUTE=120
MESSAGE_TTL=24h
FILE_TTL=24h
REPLAY_TTL=1h
TIMESTAMP_SKEW=5m
MAX_FILE_SIZE_MB=100
MAX_FILE_DOWNLOADS=10

# Optional comma-separated browser origin allowlist.
# Empty means same-host, localhost and .onion origins are allowed by the server policy.
CORS_ALLOWED_ORIGINS=

# Optional external Tor hidden service address shown to clients.
ONION_ADDRESS=

# HTTPS is terminated outside this container.
# Put Caddy, Nginx, Cloudflare Tunnel or another reverse proxy in front of http://localhost:5000.
