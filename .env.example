# CipherNode Go relay environment

PORT=5000
HOST=0.0.0.0

# Relay limits
RATE_LIMIT_PER_MINUTE=120
MESSAGE_TTL=24h
FILE_TTL=24h
REPLAY_TTL=1h
TIMESTAMP_SKEW=5m
MAX_FILE_SIZE_MB=100
MAX_FILE_DOWNLOADS=10

# Optional comma-separated browser origin allowlist.
# Empty means same-host, localhost and .onion origins are allowed by the server policy.
CORS_ALLOWED_ORIGINS=

# Optional external Tor hidden service address shown to clients.
ONION_ADDRESS=

# ÖNEMLİ: Aşağıdaki değeri MUTLAKA değiştir!
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=BURAYA_EN_AZ_32_KARAKTER_RASTGELE_STRING_YAZ

# HTTPS is terminated outside this container.
# Put Caddy, Nginx, Cloudflare Tunnel or another reverse proxy in front of http://localhost:5000.

# Stripe (RelayWorks SaaS — opsiyonel)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PERSONAL=price_...
# STRIPE_PRICE_TEAM=price_...
# APP_URL=https://relayworks.xyz
