# ╔══════════════════════════════════════════════════════════════╗
# ║           CipherNode — Web App Dockerfile                    ║
# ║                                                              ║
# ║  Expo web uygulamasını derler ve nginx ile servis eder.      ║
# ║  Relay sunucusunun önünde API proxy olarak çalışır.          ║
# ║                                                              ║
# ║  Mimari:                                                     ║
# ║    Tarayıcı → :8080 (nginx)                                  ║
# ║      /          → Expo SPA (static)                          ║
# ║      /api/*     → relay:5000 (proxy)                         ║
# ║      /socket.io → relay:5000 (proxy, WebSocket)              ║
# ╚══════════════════════════════════════════════════════════════╝

# ── Aşama 1: Expo web derle ────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# Bağımlılıkları önce kopyala (katman cache için)
COPY package*.json ./
RUN npm ci --ignore-scripts

# Uygulama kaynak kodunu kopyala
COPY . .

# EXPO_PUBLIC_SERVER_URL boş bırakılıyor:
# getApiUrl() → window.location.origin kullanır → nginx proxy üzerinden otomatik çalışır
# Go relay yalnızca ham WebSocket (/ws) konuşur — web istemcisi de ham WS kullanmalı.
ENV EXPO_PUBLIC_RELAY_TRANSPORT=websocket
RUN npx expo export --platform web --output-dir /app/web-dist 2>&1 | tail -5

# ── Aşama 2: Nginx ile servis et ──────────────────────────────
FROM nginx:alpine AS runner

RUN apk update && apk upgrade --no-cache

# Özel nginx yapılandırması
COPY nginx/docker-web.conf /etc/nginx/conf.d/default.conf

# Derlenmiş web uygulamasını kopyala
COPY --from=builder /app/web-dist /usr/share/nginx/html

# Nginx varsayılan ana sayfasını kaldır
RUN rm -f /usr/share/nginx/html/50x.html

# Nginx cache directory ve run directory için izinleri ayarla
RUN mkdir -p /var/cache/nginx /var/run /var/log/nginx && \
    chown -R nginx:nginx /var/cache/nginx /var/run /var/log/nginx /etc/nginx/conf.d /usr/share/nginx/html && \
    sed -i -e '/user/!b' -e '/nginx/!b' -e '/nginx/d' /etc/nginx/nginx.conf && \
    sed -i 's!/var/run/nginx.pid!/var/cache/nginx/nginx.pid!g' /etc/nginx/nginx.conf

USER nginx

EXPOSE 8080

# Sağlık kontrolü
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8080/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
