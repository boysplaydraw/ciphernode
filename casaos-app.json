{
  "name": "CipherNode",
  "description": "Accountless self-hostable E2EE messenger relay with bundled web client.",
  "image": "mero003/ciphernode:all-in-one",
  "ports": [
    {
      "container": 5000,
      "host": 5000,
      "protocol": "tcp",
      "description": "CipherNode web app and relay API"
    }
  ],
  "environment": {
    "NODE_ENV": "production",
    "PORT": "5000",
    "HTTPS": "false"
  },
  "restart": "unless-stopped",
  "webui": "http://[HOST]:5000/app",
  "healthcheck": {
    "test": [
      "CMD",
      "node",
      "-e",
      "require('http').get('http://localhost:' + (process.env.PORT||5000) + '/api/health', r => process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"
    ],
    "interval": "30s",
    "timeout": "10s",
    "retries": 3,
    "start_period": "20s"
  }
}
