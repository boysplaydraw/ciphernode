FROM node:22-alpine AS build
WORKDIR /app
ENV ELECTRON_SKIP_BINARY_DOWNLOAD=1
ARG EXPO_PUBLIC_SERVER_URL=
ARG EXPO_PUBLIC_WS_URL=
ARG EXPO_PUBLIC_RELAY_TRANSPORT=websocket
ENV EXPO_PUBLIC_SERVER_URL=$EXPO_PUBLIC_SERVER_URL
ENV EXPO_PUBLIC_WS_URL=$EXPO_PUBLIC_WS_URL
ENV EXPO_PUBLIC_RELAY_TRANSPORT=$EXPO_PUBLIC_RELAY_TRANSPORT
COPY package*.json ./
RUN npm ci --ignore-scripts
COPY . .
RUN npx expo export --platform web --output-dir dist

FROM nginx:alpine
RUN apk update && apk upgrade --no-cache
COPY --from=build /app/dist /usr/share/nginx/html
COPY infra/docker/nginx.conf /etc/nginx/conf.d/default.conf

# Setup non-root user for nginx
RUN mkdir -p /var/cache/nginx /var/run /var/log/nginx && \
    chown -R nginx:nginx /var/cache/nginx /var/run /var/log/nginx /etc/nginx/conf.d /usr/share/nginx/html && \
    sed -i -e '/user/!b' -e '/nginx/!b' -e '/nginx/d' /etc/nginx/nginx.conf && \
    sed -i 's!/var/run/nginx.pid!/var/cache/nginx/nginx.pid!g' /etc/nginx/nginx.conf

USER nginx
EXPOSE 80
