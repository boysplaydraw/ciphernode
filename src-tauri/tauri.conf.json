{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CipherNode",
  "version": "0.1.3",
  "identifier": "site.cipher.node",
  "build": {
    "beforeDevCommand": "npm run desktop:web:dev",
    "devUrl": "http://localhost:8081",
    "beforeBuildCommand": "npm run desktop:web:build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "CipherNode",
        "width": 1000,
        "height": 720,
        "minWidth": 400,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/ciphernode-backend"],
    "icon": ["icons/icon.ico", "icons/icon.png", "icons/icon.icns"]
  }
}
